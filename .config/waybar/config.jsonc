{
	"layer": "top",
	"margin": "1px 0px 2px 0px",
	"modules-left": [
		"hyprland/workspaces"
	],
	"modules-center": [
		"hyprland/window"
	],
	"modules-right": [
		"tray",
		"cpu",
		"memory",
		"battery",
		"clock"
	],
	"hyprland/workspaces": {
		"format": "{windows} {id}",
		"window-rewrite-default": "",
		"window-rewrite": {
			"title<.*youtube.*>": "",
			"zen": "󰈹",
			"foot": "",
			"code": "󰨞",
			"cursor": "󰨞",
			"rider": "",
			"telegram": "",
			"steam": "",
			"equibop": ""
		}
	},
	"hyprland/window": {},
	"tray": {
		"icon-size": 18,
		"spacing": 8,
		"show-passive-items": false
	},
	"cpu": {
		"states": {
			"warning": 70,
			"critical": 90
		},
		"format": "{usage}% ",
		"interval": 6
	},
	"memory": {
		"states": {
			"warning": 70,
			"critical": 90
		},
		"format": "{}% ",
		"interval": 6
	},
	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{capacity}% {icon}",
		"format-discharging": "{capacity}% {icon}",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"interval": 60
	},
	"clock": {
		"format": "{:%H:%M.%S}",
		"tooltip-format": "{:%A, %B %d}",
		"interval": 1
	}
}
